# The Seller Centre portal of the KACHI API (local backend: port 8001).
NEXT_PUBLIC_SELLER_API_URL=http://localhost:8001/api/v1
# The shop portal, read for the public catalogue (categories, brands) and product links.
NEXT_PUBLIC_SHOP_API_URL=http://localhost:8000/api/v1
# Where the storefront lives, for "view in shop" links.
NEXT_PUBLIC_SHOP_URL=http://localhost:3000
# Cloudflare Turnstile site key for the bot check on sign-up and sign-in. Leave empty to hide the
# widget (the backend checks tokens only while its TURNSTILE_SECRET_KEY is set).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# "true" while the backend runs the mock payment gateway (NOQODI_DRIVER=mock, never production):
# ads awaiting payment then get "test payment" buttons instead of the payment page link.
NEXT_PUBLIC_MOCK_PAYMENTS=false
